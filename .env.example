# Port to run the server and dashboard on (optional, defaults to 3000)
PORT=3000

# Name of your restaurant (optional, defaults to "Sweet Bite")
STORE_NAME=Sweet Bite

# WhatsApp number of the Lapaz branch staff/kitchen to receive new orders & request reports
# e.g., 233241234567 (with country code, no + or spaces)
LAPAZ_BRANCH_NUMBER=

# Supabase database (optional, for persistent order logs and PDF reports)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
